# Use separate environment files for testnet and mainnet. Never commit real keys.
CHAIN=testnet
RPC_HTTP=https://testnet-rpc.monad.xyz
RPC_WS=wss://testnet-rpc.monad.xyz
MARKET_ADDRESS=
FAUCET_ADDRESS=
RELAYER_PK=
KEEPER_PK=
MO_PK=
PETE_PK_1=
PETE_PK_2=
PETE_PK_3=
PETE_PK_4=
# Optional throwaway key for scripts/live-spike.ts (testnet only).
TESTNET_PK=
# TESTNET_PRIVATE_KEY is also accepted for the live spike.
BOTS_URL=http://127.0.0.1:3001
BOTS_TOKEN=
ENVIO_GRAPHQL_URL=
PETE_PRIORITY_MULT=10
PETE_BURST_BLOCKS=20
PETE_DAILY_CAP=10
MO_AWAKE_SECONDS=90
RELAY_PER_ADDR_PER_MIN=6
PORT=3001
# S4 deployment/operations. Keep mainnet activation false until calls/cost approved.
DEPLOYER_PK=
MAINNET_DEPLOY_APPROVED=false
MAINNET_SENDS_ENABLED=false
# Deployment block (required for complete restart recovery with custom addresses).
START_BLOCK=
MO_SEED=42
# Separate funded testnet throwaway key; never reuse a bot key.
ASHA_PK=
# S5: set the actual Envio Cloud endpoint after deployment; do not use HyperSync as GraphQL.
ENVIO_API_TOKEN=
PUBLIC_ENVIO_GRAPHQL_URL=
PUBLIC_CHAIN=testnet
PUBLIC_MARKET_ADDRESS=
# Web development: place PUBLIC_* in apps/web/.env; hosted web: set in Vercel.
# Indexer: configure validates the market, then generates an ignored deployment config.
# S6 web: choose the permanent production hostname BEFORE creating user passkeys.
# Required in production; localhost is permitted only by the development server.
PUBLIC_RP_ID=
PUBLIC_RPC_HTTP=https://testnet-rpc.monad.xyz
PUBLIC_RPC_WS=wss://testnet-rpc.monad.xyz
# Mirror PUBLIC_CHAIN/PUBLIC_MARKET_ADDRESS with server CHAIN/MARKET_ADDRESS.
# Web server additionally needs RPC_HTTP, RELAYER_PK, FAUCET_ADDRESS, BOTS_URL,
# BOTS_TOKEN; mainnet sending requires MAINNET_SENDS_ENABLED=true after approval.
