# Use separate environment files for testnet and mainnet. Never commit real keys.
CHAIN=testnet
RPC_HTTP=https://testnet-rpc.monad.xyz
RPC_WS=wss://testnet-rpc.monad.xyz
MARKET_ADDRESS=
FAUCET_ADDRESS=
RELAYER_PK=
KEEPER_PK=
MO_PK=
PETE_PK_1=
PETE_PK_2=
PETE_PK_3=
PETE_PK_4=
# Optional throwaway key for scripts/live-spike.ts (testnet only).
TESTNET_PK=
# TESTNET_PRIVATE_KEY is also accepted for the live spike.
BOTS_URL=http://127.0.0.1:3001
BOTS_TOKEN=
ENVIO_GRAPHQL_URL=
PETE_PRIORITY_MULT=10
PETE_BURST_BLOCKS=20
PETE_DAILY_CAP=10
MO_AWAKE_SECONDS=90
RELAY_PER_ADDR_PER_MIN=6
PORT=3001

# --- Next.js terminal (public values only; never put keys in NEXT_PUBLIC_ variables) ---
# Add only when the backend/contract configuration is agreed.
# NEXT_PUBLIC_CHAIN_ID=
# NEXT_PUBLIC_RPC_URL=
# NEXT_PUBLIC_MARKET_DATA_URL=
# Set only to a real, verified BatchAuction deployment on the chain above.
# NEXT_PUBLIC_MARKET_ADDRESS=
# Leave unset. "enabled" switches on untested contract reads; see src/lib/market-data/onchain.ts.
# NEXT_PUBLIC_CONTRACT_READS=
