{
  "name": "batchelor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "gen": "node --experimental-strip-types scripts/gen-abi.ts",
    "spike": "python3 scripts/spike.py",
    "sample:testnet": "python3 scripts/sample-testnet.py",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter web dev",
    "check:security": "python3 scripts/check-security.py",
    "check:secrets": "python3 scripts/check-secrets.py",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check:contracts": "python3 scripts/check-contracts.py",
    "spike:live": "node --env-file-if-exists=.env --experimental-strip-types scripts/live-spike.ts",
    "bench": "bash contracts/bench/run.sh",
    "bench:live": "CHAIN=testnet node --env-file-if-exists=.env --experimental-strip-types scripts/live-clear.ts",
    "check:gas": "node --experimental-strip-types scripts/check-gas.ts",
    "deploy:plan": "node --env-file-if-exists=.env --experimental-strip-types scripts/deploy.ts",
    "funding:plan": "node --env-file-if-exists=.env --experimental-strip-types scripts/funding-plan.ts",
    "test:tooling": "vitest run scripts/*.test.ts",
    "verify:bundle": "node --experimental-strip-types scripts/verification-bundle.ts",
    "bots:test-local": "node --experimental-strip-types scripts/test-bots-local.ts",
    "web:test-local": "node --experimental-strip-types scripts/test-web-local.ts",
    "proof:tests": "python3 scripts/export-test-summary.py",
    "proof:generate": "python3 scripts/generate-proof.py",
    "receipts:test-local": "node --experimental-strip-types scripts/test-receipts-local.ts",
    "terminal:dev": "next dev",
    "terminal:build": "next build",
    "terminal:start": "next start",
    "terminal:lint": "eslint",
    "terminal:typecheck": "tsc --noEmit",
    "terminal:test": "vitest run --config vitest.terminal.config.ts"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
